// RetailPOS Database Schema
// Tech Stack: Next.js 16 + Prisma + PostgreSQL
// Pattern: Retail ERP/POS (no gastronomía)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Required Models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// User & Auth
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(CASHIER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  sales            Sale[]
  transfers        Transfer[]
  purchaseOrders   PurchaseOrder[]
  openedCashSessions CashSession[]       @relation("OpenedCashSessions")
  closedCashSessions CashSession[]       @relation("ClosedCashSessions")
  cashMovements      CashMovement[]
  inventoryMovements InventoryMovement[]
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

// ============================================
// Locations (Sucursales)
// ============================================

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory        Inventory[]
  sales            Sale[]
  transfersFrom    Transfer[]        @relation("FromLocation")
  transfersTo      Transfer[]        @relation("ToLocation")
  purchaseOrders   PurchaseOrder[]
  cashSessions     CashSession[]
  cashMovements    CashMovement[]
  inventoryMovements InventoryMovement[]
}

// ============================================
// Products & Categories
// ============================================

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]
}

model Product {
  id                String   @id @default(cuid())
  productNumber     Int      @unique @default(autoincrement())
  name              String
  slug              String   @unique
  sku               String?  @unique
  description       String?  @db.Text
  price             Decimal  @db.Decimal(10, 2)
  cost              Decimal? @db.Decimal(10, 2)
  barcode           String?  @unique
  image             String?
  isActive          Boolean  @default(true)
  lowStockThreshold Decimal  @db.Decimal(12, 3) @default(10)
  unitOfMeasure     UnitOfMeasure @default(UNIT)
  customUnitName    String?
  categoryId        String?
  supplierId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category        Category?           @relation(fields: [categoryId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  inventory       Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems       SaleItem[]
  transferItems   TransferItem[]
  orderItems      PurchaseOrderItem[]
  promotionProducts PromotionProduct[]
  promotionComboItems PromotionComboItem[]
  promotionTiers PromotionTier[]
}

enum UnitOfMeasure {
  UNIT
  ML
  G
  KG
  LT
  OTHER
}

model Inventory {
  id         String   @id @default(cuid())
  productId  String
  locationId String
  quantity   Decimal  @db.Decimal(12, 3) @default(0)
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([locationId])
  @@index([productId])
}

// ============================================
// Sales & Transactions
// ============================================

model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique @default(cuid())
  userId        String
  locationId    String
  cashSessionId String?
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2) @default(0)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  cashSession CashSession? @relation(fields: [cashSessionId], references: [id])
  items    SaleItem[]
  inventoryMovements InventoryMovement[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

// ============================================
// Caja / Turnos / Arqueos
// ============================================

model CashSession {
  id                    String            @id @default(cuid())
  locationId            String
  openedByUserId        String
  closedByUserId        String?
  registerLabel         String
  shiftLabel            ShiftLabel
  status                CashSessionStatus @default(OPEN)
  businessDate          DateTime
  openingCashAmount     Decimal           @db.Decimal(10, 2)
  countedCashAmount     Decimal?          @db.Decimal(10, 2)
  expectedCashAmount    Decimal?          @db.Decimal(10, 2)
  differenceAmount      Decimal?          @db.Decimal(10, 2)
  openingNotes          String?           @db.Text
  closingNotes          String?           @db.Text
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  location       Location        @relation(fields: [locationId], references: [id])
  openedBy       User            @relation("OpenedCashSessions", fields: [openedByUserId], references: [id])
  closedBy       User?           @relation("ClosedCashSessions", fields: [closedByUserId], references: [id])
  sales          Sale[]
  movements      CashMovement[]

  @@index([locationId, status])
  @@index([businessDate])
}

model CashMovement {
  id              String               @id @default(cuid())
  cashSessionId   String
  locationId      String
  userId          String
  type            CashMovementType
  category        CashMovementCategory
  paymentMethod   PaymentMethod
  amount          Decimal              @db.Decimal(10, 2)
  description     String               @db.Text
  createdAt       DateTime             @default(now())
  purchaseOrderId String?

  cashSession   CashSession   @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  location      Location      @relation(fields: [locationId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([cashSessionId, createdAt])
  @@index([locationId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum ShiftLabel {
  MANANA
  TARDE
  OTRO
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CashMovementCategory {
  APERTURA
  INGRESO_MANUAL
  EGRESO_MANUAL
  RETIRO
  GASTO
  PAGO_PROVEEDOR
  AJUSTE
}

// ============================================
// Transfers Between Locations
// ============================================

model Transfer {
  id             String         @id @default(cuid())
  reference      String         @unique @default(cuid())
  fromLocationId String
  toLocationId   String
  userId         String
  status         TransferStatus @default(PENDING)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromLocation Location        @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location        @relation("ToLocation", fields: [toLocationId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  items        TransferItem[]
  inventoryMovements InventoryMovement[]
}

model TransferItem {
  id         String @id @default(cuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// ============================================
// Suppliers
// ============================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  contact   String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

// ============================================
// Purchase Orders
// ============================================

model PurchaseOrder {
  id             String             @id @default(cuid())
  orderNumber    String             @unique @default(cuid())
  supplierId     String
  locationId     String
  userId         String
  status         PurchaseOrderStatus @default(PENDING)
  subtotal       Decimal            @db.Decimal(10, 2) @default(0)
  tax            Decimal            @db.Decimal(10, 2) @default(0)
  total          Decimal            @db.Decimal(10, 2) @default(0)
  expectedDate   DateTime?
  receivedDate   DateTime?
  notes          String?            @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  location   Location           @relation(fields: [locationId], references: [id])
  user       User               @relation(fields: [userId], references: [id])
  items      PurchaseOrderItem[]
  cashMovements CashMovement[]
  inventoryMovements InventoryMovement[]
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal @db.Decimal(12, 3)
  receivedQty     Decimal @db.Decimal(12, 3) @default(0)
  unitCost        Decimal @db.Decimal(10, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

// ============================================
// Inventory Ledger
// ============================================

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String
  locationId      String
  userId          String?
  saleId          String?
  purchaseOrderId String?
  transferId      String?
  type            InventoryMovementType
  quantityDelta   Decimal @db.Decimal(12, 3)
  quantityBefore  Decimal @db.Decimal(12, 3)
  quantityAfter   Decimal @db.Decimal(12, 3)
  notes           String?               @db.Text
  createdAt       DateTime              @default(now())

  product       Product        @relation(fields: [productId], references: [id])
  location      Location       @relation(fields: [locationId], references: [id])
  user          User?          @relation(fields: [userId], references: [id])
  sale          Sale?          @relation(fields: [saleId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  transfer      Transfer?      @relation(fields: [transferId], references: [id])

  @@index([productId, locationId, createdAt])
  @@index([saleId])
  @@index([purchaseOrderId])
  @@index([transferId])
}

enum InventoryMovementType {
  INITIAL
  SALE
  PURCHASE_RECEIPT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  MANUAL_IN
  MANUAL_OUT
}

// ============================================
// Promotions
// ============================================

model Promotion {
  id             String         @id @default(cuid())
  name           String
  description    String?        @db.Text
  type           PromotionType
  comboPrice     Decimal?       @db.Decimal(10, 2)
  discountPercent Decimal?      @db.Decimal(5, 2)
  discountAmount Decimal?       @db.Decimal(10, 2)
  isActive       Boolean        @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products       PromotionProduct[]
  comboItems     PromotionComboItem[]
  tiers          PromotionTier[]
}

model PromotionProduct {
  id           String    @id @default(cuid())
  promotionId  String
  productId    String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

model PromotionComboItem {
  id           String @id @default(cuid())
  promotionId  String
  productId    String
  quantity     Int    @default(1)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

model PromotionTier {
  id                String   @id @default(cuid())
  promotionId       String
  productId         String?
  minimumQuantity   Int
  discountPercent   Decimal? @db.Decimal(5, 2)
  discountAmount    Decimal? @db.Decimal(10, 2)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@index([promotionId, minimumQuantity])
}

enum PromotionType {
  COMBO
  SCALE
}

enum PurchaseOrderStatus {
  PENDING
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}
