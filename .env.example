# App runtime in Vercel (Supabase transaction pooler)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Prisma CLI and migrations (direct database connection)
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="https://your-project.vercel.app"

# One-time admin bootstrap for the production app
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
